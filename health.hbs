{{!< default}}
<main class="health-layout">
<section class="health-section-one">
  {{!-- top header --}}
  <div class="health-header">
    <h1>health</h1>
  </div>
  <section class="main-top-section-health">
    {{!-- mental health articles --}}
    <div class="xmental">
      {{#get "posts" filter="tag:hash-mental-health" limit="4" include="tags,authors" order="published_at_desc"}}
      {{!-- get the tag dynamically --}}
      {{#get "tags" filter="tag:hash-mental-health" limit="1"}}
      {{# if tags.length}}
      {{#foreach tags}}
      <div class="category-header">
        <h1><a href="{{url}}">{{name}}</a></h1>
        <a href="#" aria-label="more health" class="more-arrow">›</a>
      </div>
      {{/foreach}}
      {{/if}}
      {{else}}
      <div class="category-header">
        <h1><a href="#">mental health</a></h1>
        <a href="#" aria-label="more health" class="more-arrow">›</a>
      </div>
      {{/get}}
      <div class="xmental-article-container">
      {{#if posts.length}}
      {{#foreach posts}}
        <article class="xmental-article">
          <div>
            <h2><a href="{{url}}">{{title}}</a></h2>
          </div>
          <div class="xmental-meta">
            {{!-- author --}}
            <div class="xmental-author">
              {{#if primary_author}}
              <a href="{{primary_author.url}}">
                By <span>{{primary_author.name}}</span>
              </a>
              {{/if}}
            </div>
            {{!-- published date --}}
            <div class="xmental-date">
              <p>{{date published_at timeago="true"}}</p>
            </div>
          </div>
        </article>
      {{/foreach}}
      {{/if}}
      </div>
      {{/get}}
    </div>
    {{!-- other health news --}}
    <div class="health-latest-container">
      <div class="top-health-article">
        {{#get "posts" filter="tag:health" limit="1" include="tags,authors" order="published_at desc"}}
        {{#get "tags" filter="slug:health" limit="1"}}
        {{# if tags.length}}
        {{#foreach tags}}
        <div class="category-header">
          <h1><a href="{{url}}">{{name}}</a></h1>
          <a href="#" aria-label="more health" class="more-arrow">›</a>
        </div>
        {{/foreach}}
        {{/if}}
        {{else}}
        <div class="category-header">
          <h1><a href="#">health</a></h1>
          <a href="#" aria-label="more health" class="more-arrow">›</a>
        </div>
        {{/get}}
        {{#if posts.length}}
        {{#foreach posts}}
        <article class="health-hero-card">
          <div class="health-hero-media">
            {{#if feature_image}}
            <a href="{{url}}">
              <img src="{{feature_image}}" alt="{{title}}" />
            </a>
            {{/if}}
          </div>
          <div class="health-hero-overlay">
            {{#if primary_tag}}
            <div class="health-hero-tag">
              <a href="{{primary_tag.url}}" class="health-tag-link">{{primary_tag.name}}</a>
            </div>
            {{/if}}
            <a href="{{url}}">
              <h3 class="health-hero-title">{{title}}</h3>
              <p class="health-hero-excerpt">{{excerpt words="20"}}</p>
            </a>
            {{!-- author --}}
            <div class="xmental-author other-side-author">
              {{#if primary_author}}
              <a href="{{primary_author.url}}">
                By <span>{{primary_author.name}}</span>
              </a>
              {{/if}}
            </div>
          </div>
        </article>
        {{/foreach}}
        {{/if}}
        {{/get}}
      </div>
      <div class="health-sidebar">
          {{#get "posts" filter="tag:health" limit="5" include="tags,authors" order="published_at desc"}}
          {{#if posts.length}}
          <div class="health-sidebar-first-list">
            {{#foreach posts from=2 to=2}}
            <article class="health-sidebar-card">
              <div class="health-sidebar-media">
                <a href="{{url}}">
                  {{#if feature_image}}
                  <img src="{{feature_image}}" alt="{{title}}" />
                  {{/if}}
                </a>
              </div>
              <div class="health-sidebar-content">
                {{#if primary_tag}}
                <div class="primary-tag">
                  <a href="{{primary_tag.url}}">
                    {{primary_tag.name}}
                  </a>
                </div>
                {{/if}}
                {{!-- the content --}}
                <div class="health-title-sider">
                  <a href="{{url}}">
                    <h2>{{title}}</h2>
                  </a>
                </div>
              {{!-- author --}}
              <div class="xmental-author other-side-author">
                {{#if primary_author}}
                <a href="{{primary_author.url}}">
                  By <span>{{primary_author.name}}</span>
                </a>
                {{/if}}
              </div>
              </div>
            </article>
            {{/foreach}}
            <div class="health-sidebar-second-list">
              {{#foreach posts from="3" to="4"}}
                <article class="health-sidebar-second-list-article">
                  {{#if primary_tag}}
                  <div class="primary-tag">
                    <a href="{{primary_tag.url}}">
                      {{primary_tag.name}}
                    </a>
                  </div>
                  {{/if}}
                  <div class="health-title-sider">
                    <a href="{{url}}">
                      <h2>{{title}}</h2>
                    </a>
                  </div>
                 
                  {{!-- author --}}
                  <div class="xmental-author other-side-author">
                    {{#if primary_author}}
                    <a href="{{primary_author.url}}">
                      By <span>{{primary_author.name}}</span>
                    </a>
                    {{/if}}
                  </div>
                </article>
              {{/foreach}}
            </div>
          </div>
          {{/if}}
          {{/get}}
        </div>
    </div>
    </section>
  </section>
  {{!-- Epidemics Section --}}
  <section class="category-section epidemics-section">
    {{#get "posts" filter="tag:hash-epidemics" limit="4" include="tags,authors" order="published_at desc"}}
    {{#if posts.length}}
    {{#get "tags" filter="tag:hash-epidemics" limit="1"}}
    {{# if tags.length}}
    {{#foreach tags}}
    <div class="category-header">
      <h1><a href="{{url}}">{{name}}</a></h1>
      <a href="#" aria-label="more health" class="more-arrow">›</a>
    </div>
    {{/foreach}}
    {{/if}}
    {{else}}
    <div class="category-header">
      <h1><a href="#">Epidemics</a></h1>
      <a href="#" aria-label="more health" class="more-arrow">›</a>
    </div>
    {{/get}}
    <div class="category-container">
      {{#foreach posts}}
      <article class="opinion-card">
        <div class="card-image-wrapper">
          <a href="{{url}}">
            {{#if feature_image}}
            <img src="{{feature_image}}" alt="{{title}}">
            {{/if}}
          </a>
        </div>
        <div class="card-content">
          <div>
            {{#if primary_author}}
            <div class="primary-author">
              <div class="primary-author-container">
                {{#if primary_author.profile_image}}
                <img class="primary-author-avatar" src="{{primary_author.profile_image}}" alt="{{primary_author.name}}">
                {{/if}}
                <span class="primary-author-name">
                  <a href="{{primary_author.url}}">
                    By {{primary_author.name}}
                  </a>
                </span>
              </div>
            </div>
            {{/if}}
            <a href="{{url}}">
              <h3>{{title}}</h3>
            </a>
          </div>
          <div class="card-meta">
            <div class="card-date">
              <span>{{date published_at timeago="true"}} ·</span>
            </div>
          </div>
        </div>
      </article>
      {{/foreach}}
    </div>
    {{/if}}
    {{/get}}
  </section>

