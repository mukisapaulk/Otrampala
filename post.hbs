{{!< default}} 
<main class="otra-post-main">
    {{#post}}
    <article class="otra_article {{post_class}}">

        <header class="otra_article-header">
            <div class="otra_article-header-wrapper">
                <div class="otra_article-meta">
                    {{> "post-meta"}}
                </div>
                <div class="otra_article-head">
                    {{#if primary_tag}}
                    <a class="otra_article-tag" href="{{primary_tag.url}}">{{primary_tag.name}}</a>
                    {{/if}}
                    <h1 class="otra_article-title">{{title}}</h1>
                    {{#if custom_excerpt}}
                    <p class="otra_article-excerpt">{{custom_excerpt}}</p>
                    {{/if}}
                    {{#if reading_time}}
                        <span class="otra-article-length">
                            {{> "icons/read"}}
                            <p>{{reading_time minute=(t "1 min") minutes=(t "% min")}} read time</p>
                        </span>
                    {{/if}}
                </div>
            </div>
        </header>
        <div class="otra_article-featuredimg_wrapper">
            {{> "feature-image"}}
        </div>       
        <section class="otra_content">
            <div class="otra_article-content">
                {{> "primary-author"}}
                <div class="otra_article-post">
                    {{content}}
                </div>  
            </div>
            <div class="otra_article-mostpopular">
                {{> "otra-most-popular"}}
            </div>
        </section>
    </article>
    {{/post}}
    <div class="otra-realted">
        <div class="otra-realted-e">{{> "related-posts"}}</div>
        <div class="otra-realted-n"></div>
    </div>
        
    {{#post}}
    {{> "comments"}}
    {{/post}}
    </main>