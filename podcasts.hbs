{{!< default}} <main class="otra-pod-layout">

    {{#get "posts" filter="tag:podcasts" order="published_at desc" limit="12" include="tags,authors"}}
    {{#if posts}}

    {{!-- latest podcast (first post only) --}}
    {{#foreach posts}}
    {{#if @first}}
    <section class="otra-pod-latest">
        <div class="otra-pod-latest-content">
            <div>
                <span class="otra-pod-latest-category">Latest Episode</span>
                <a href="{{url}}" class="otra-pod-latest-link">
                    <h1 class="otra-pod-latest-title">{{title}}</h1>
                </a>
                {{#if custom_excerpt}}
                <p class="otra-pod-latest-desc">{{custom_excerpt}}...</p>
                {{else}}
                <p class="otra-pod-latest-desc">{{excerpt words="25"}}...</p>
                {{/if}}
            </div>

            <div class="otra-pod-listen">
                <a href="{{url}}" class="otra-pod-listen-btn">
                    <span>Listen Now</span>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" fill="currentColor">
                        <path
                            d="M187.2 100.9C174.8 94.1 159.8 94.4 147.6 101.6C135.4 108.8 128 121.9 128 136L128 504C128 518.1 135.5 531.2 147.6 538.4C159.7 545.6 174.8 545.9 187.2 539.1L523.2 355.1C536 348.1 544 334.6 544 320C544 305.4 536 291.9 523.2 284.9L187.2 100.9z" />
                    </svg>
                </a>
            </div>
        </div>

        <div class="otra-pod-latest-image">
            {{#if feature_image}}
            <img src="{{img_url feature_image size='l'}}" alt="{{title}}" loading="lazy">
            {{else}}
            <div class="otra-pod-latest-placeholder"></div>
            {{/if}}
        </div>
    </section>
    {{/if}}
    {{/foreach}}

    {{!-- other podcasts, only if there is a second post --}}
{{#if posts.[1]}}
<section id="main-content" class="otra-pod-more">
    <div class="otra-pod-more-inner">

        <header class="otra-pod-more-header">
            {{#get "tags" filter="slug:podcasts" limit="1"}}
            {{#foreach tags}}
            <h2 class="otra-pod-more-title">more {{name}}</h2>
            {{#if description}}
            <p class="otra-pod-more-desc">{{description}}</p>
            {{/if}}
            {{/foreach}}
            {{/get}}
        </header>

        <section class="otra-pod-grid">
        {{#foreach posts from="2"}}
        <article class="otra-pod-card">
            <a href="{{url}}" class="otra-pod-card-link" aria-label="Listen to {{title}}">
                <div class="otra-pod-card-image">
                    {{#if feature_image}}
                    <img src="{{img_url feature_image size='l'}}" alt="" loading="lazy">
                    {{else}}
                    <div class="otra-pod-card-placeholder"></div>
                    {{/if}}
        
                    <div class="otra-pod-card-overlay">
                        <span class="otra-pod-card-play">
                            <span class="otra-pod-card-play-text">Listen</span>
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" fill="currentColor">
                                <path
                                    d="M187.2 100.9C174.8 94.1 159.8 94.4 147.6 101.6C135.4 108.8 128 121.9 128 136L128 504C128 518.1 135.5 531.2 147.6 538.4C159.7 545.6 174.8 545.9 187.2 539.1L523.2 355.1C536 348.1 544 334.6 544 320C544 305.4 536 291.9 523.2 284.9L187.2 100.9z" />
                            </svg>
                        </span>
                        <h3 class="otra-pod-card-title">{{title}}</h3>
                    </div>
                </div>
            </a>
        </article>
        {{/foreach}}
        </section>
    </div>
</section>
{{/if}}

    {{else}}
    {{!-- fallback: no podcasts --}}
    <section class="otra-pod-empty">
        <h1 class="otra-pod-empty-title">No episodes yet</h1>
        <p class="otra-pod-empty-text">We're recording something good. Check back soon.</p>
        <a href="{{@site.url}}" class="otra-pod-empty-btn">Back to home</a>
    </section>
    {{/if}}
    {{/get}}

    </main>