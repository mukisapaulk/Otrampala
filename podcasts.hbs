{{!< default}}

<main class="podcast-layout">
{{!-- latest podcast --}}
  {{#get "posts" filter="tag:podcasts" limit="1" include="tags,authors"}}
    {{#foreach posts}}
      <section class="latest-padcast-container">
        <div class="latest-padcast-content">
          {{!-- latest body --}}
          <div>
            <span class="latest-padcast-category">Latest Episode</span>
            <a href="{{url}}" class="latest-padcast-title-link">
              <h1 class="latest-padcast-main-title">{{title}}</h1>
            </a>
            {{#if custom_excerpt}}
            <p class="latest-padcast-description">{{custom_excerpt}}...</p>
            {{else}}
            <p class="latest-padcast-description">{{excerpt words="25"}}...</p>
            {{/if}}
          </div>
          {{!-- listen button --}}
          <div class="listen-container">
            <a href="{{url}}" class="latest-padcast-listen-button">
              <span>Listen Now</span>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640
                                                            640" fill="currentColor">
                <path
                  d="M187.2 100.9C174.8 94.1 159.8 94.4 147.6 101.6C135.4 108.8 128 121.9 128 136L128 504C128 518.1 135.5 531.2 147.6 538.4C159.7 545.6 174.8 545.9 187.2 539.1L523.2 355.1C536 348.1 544 334.6 544 320C544 305.4 536 291.9 523.2 284.9L187.2 100.9z" />
              </svg>
            </a>
           
          </div>
        </div>
        <div class="latest-padcast-card-image">
          {{#if feature_image}}
          <img src="{{img_url feature_image size=" l"}}" alt="{{title}}" loading="lazy">
          {{else}}
          <div class="latest-padcast-card-placeholder"></div>
          {{/if}}
        </div>
      </section>
    {{/foreach}}
  {{/get}}
 {{!-- the other podcasts --}}
<section id="main-content" class="more-podcast-main">
  <div class="more-podcast-container">
    {{#get "posts" filter="tag:podcasts" limit="12" order="published_at desc" include="tags,authors"}}
    {{!-- the header --}}
    <header class="more-podcast-header">
      <div class="more-podcast-header-inner">
        {{#get "tags" filter="slug:podcasts" limit="1"}}
        {{#foreach tags}}
        <h2 class="more-podcast-header-title">more {{name}}</h2>
        {{#if description}}
        <p class="more-podcast-header-description">{{description}}</p>
        {{/if}}
        {{/foreach}}
        {{/get}}
      </div>
    </header>
    {{!-- more podcasts --}}
   <section class="more-podcasts-container">
     {{#foreach posts from="2"}}
    <article class="more-podcast-card">
      <a href="{{url}}" class="more-podcast-card-link" aria-label="Listen to {{title}}">
        <div class="more-podcast-card-image">
          {{#if feature_image}}
          <img src="{{img_url feature_image size=" l"}}" alt="{{title}}" loading="lazy">
          {{else}}
          <div class="more-podcast-card-placeholder"></div>
          {{/if}}
        </div>
        <div class="more-podcast-card-content">
          <h3 class="more-podcast-card-title">{{title}}</h3>
        </div>
      </a>
    </article>
    {{/foreach}}
    {{/get}}
   </section>
  {{!-- padination --}}
  {{#if pagination}}
  <nav class="podcasts-pagination" aria-label="Pagination">
    {{pagination}}
  </nav>
  {{/if}}
</section>
</main>









  

  
