{{!-- politics Section --}}
<section class="category-section section-top">
  {{#get "posts" filter="tag:politics" limit="4" include="tags,authors" order="published_at desc"}}
  {{#if posts.length}}
  {{#get "tags" filter="slug:politics" limit="1"}}
  {{# if tags.length}}
  {{#foreach tags}}
  <div class="category-header">
    <h1><a href="{{url}}">{{name}}</a></h1>
    <a href="#" aria-label="more finance" class="more-arrow">›</a>
  </div>
  {{/foreach}}
  {{/if}}
  {{else}}
  <div class="category-header">
    <h1><a href="#">politics</a></h1>
    <a href="#" aria-label="more finance" class="more-arrow">›</a>
  </div>
  {{/get}}
  <div class="category-container">
    {{#foreach posts}}
    <article class="category-card-two">
      <div class="card-image-wrapper-three">
        <a href="{{url}}">
          {{#if feature_image}}
          <img src="{{feature_image}}" alt="{{title}}">
          {{/if}}
        </a>
      </div>
      <div class="card-content-style-two">
         <div class="news_body">
            <h2 class="truncate-two"><a href="{{url}}">{{title}}</a></h2>
          </div>
       {{!-- meta --}}
          <div class="news_meta news_titlextra">
            <div class="news_author_container">
              {{#if primary_author}}
              By <a href="{{primary_author.url}}">{{primary_author.name}}</a>
              {{/if}}
            </div>
            <div class="news_maindate">
              <p>{{date published_at timeago="true"}}</p>
            </div>
          </div>
      </div>
    </article>
    {{/foreach}}
  </div>
  {{/if}}
  {{/get}}
</section>