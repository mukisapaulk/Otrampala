{{#get "posts" limit="5" filter="tags.visibility:public" order="published_at desc" include="tags"}}
{{#if posts}}
<section class="otra-topstories">
    <div class="otra-topstories-inner">
        <div class="otra-topstories-grid">
            {{#foreach posts}}
            {{#if @first}}
            <div class="otra-topstories-lead">
                {{> "components/big-horizontal"}}
            </div>
            {{else}}
            <div class="otra-topstories-item">
                {{> "horinoauth"}}
            </div>
            {{/if}}
            {{/foreach}}
        </div>
    </div>
</section>
{{/if}}
{{/get}}