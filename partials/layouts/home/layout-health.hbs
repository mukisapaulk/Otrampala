{{#get "posts" filter="tag:health" limit="5" include="tags,authors"}}
{{#if posts}}
<section class="otra-topic">
    <div class="otra-topic-style__two">
        {{#get "tags" filter="slug:health" limit="1"}}
        {{#foreach tags}}
        <div class="otra-topic-name_wrapper">
            <h2 class="otra-main-heading">
                <a href="{{url}}">{{name}}</a>
            </h2>
        </div>
        {{/foreach}}
        {{/get}}

        <div class="otra-ddissc">
            <div class="otra-hero_col">
                {{#foreach posts}}
                {{#if @first}}
                {{> "vertical-withexcerpt"}}
                {{/if}}
                {{/foreach}}
            </div>

            <div class="otra-article_ar">
                {{#foreach posts}}
                {{#unless @first}}
                {{> "only-title"}}
                {{/unless}}
                {{/foreach}}
            </div>
        </div>
    </div>

    <footer class="otra-topic-footer">
        <a class="otra-topic-link" href="/tag/health/">{{t "Show more"}}
            <span>{{> "icons/arrow"}}</span>
        </a>
    </footer>
</section>
{{/if}}
{{/get}}