{{#get "posts" filter="tag:books" limit="3" include="tags,authors"}}
{{#if posts}}
<section class="otra-topic">
    <div class="otra-topic-style__one">
        {{#get "tags" filter="slug:books" limit="1"}}
        {{#foreach tags}}
        <div class="otra-topic-name">
            <h2 class="otra-tag-heading">
                <a href="{{url}}">{{name}}</a>
            </h2>
        </div>
        {{/foreach}}
        {{/get}}
        
        <div class="otra-topic-content-articles">
            {{#foreach posts}}
            {{> "vertical-card"}}
            {{/foreach}}
        </div>
    </div>
   
    <footer class="otra-topic-footer">
        <a class="otra-topic-link" href="/tag/books/">{{t "Show more"}} 
        <span>{{> "icons/arrow"}}</span>
        </a>
    </footer>
</section>
{{/if}}
{{/get}}