{{!-- finance Section --}}
<section class="category-section section-top">
  {{#get "posts" filter="tag:finance" limit="4" include="tags,authors" order="published_at desc"}}
  {{#if posts.length}}
  {{#get "tags" filter="slug:finance" limit="1"}}
  {{# if tags.length}}
  {{#foreach tags}}
  <div class="category-header">
    <h1><a href="{{url}}">{{name}}</a></h1>
    <a href="#" aria-label="more finance" class="more-arrow">›</a>
  </div>
  {{/foreach}}
  {{/if}}
  {{else}}
  <div class="category-header">
    <h1><a href="#">finance</a></h1>
    <a href="#" aria-label="more finance" class="more-arrow">›</a>
  </div>
  {{/get}}
  <div class="category-container">
    {{#foreach posts}}
    <article class="category-card-three">
      <div class="card-image-wrapper-four">
        <a href="{{url}}">
          {{#if feature_image}}
          <img src="{{feature_image}}" alt="{{title}}">
          {{/if}}
        </a>
      </div>
      <div class="card-content-style-three">
         <div class="news_body">
            <h2 class="truncate-two"><a href="{{url}}">{{title}}</a></h2>
          </div>
        <div class="xmental-meta ">
          {{!-- author --}}
          <div class="xmental-author">
            {{#if primary_author}}
            <a href="{{primary_author.url}}">
              By <span>{{primary_author.name}}</span>
            </a>
            {{/if}}
          </div>
        </div>
      </div>
    </article>
    {{/foreach}}
  </div>
  {{/if}}
  {{/get}}
</section>