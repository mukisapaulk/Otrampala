<section class="otra-section otra-section--top">
  {{#get "posts" include="tags,authors" limit="10" order="published_at desc" as |topnews| }}
  {{#if topnews.length}}

  <div class="otra-grid">
    {{#foreach topnews from=6 to=9}}
    <article class="otra-card_column">

      {{!-- featured image --}}
      <div class="otra-card-image_column">
        <a href="{{url}}">
          {{#if feature_image}}
          <img src="{{feature_image}}" alt="{{title}}">
          {{/if}}
        </a>
      </div>

      {{!-- body --}}
      <div class="otra-card-content">
        <div class="otra-tag">
          {{#if primary_tag}}
          <a href="{{primary_tag.url}}">{{primary_tag.name}}</a>
          {{/if}}
        </div>
        <h2 class="otra-title otra-truncate">
          <a href="{{url}}">{{title}}</a>
        </h2>
      </div>
    </article>
    {{/foreach}}
  </div>

  {{/if}}
  {{/get}}
</section>