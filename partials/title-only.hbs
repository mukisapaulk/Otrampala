<article class="otra-title-card {{post_class}}{{#match has_large_post " !=" false}}{{#has index=" 0"}} large{{/has}}{{/match}}">
    <a class="otra-title-card-link" href="{{url}}">
            <header class="otra-title-card-header">
                <h3 class="otra-title-heading">{{title}}</h3>
            </header>
    </a>
</article>