{{#is "post"}}
{{#get "posts" include="authors" filter="tags:[{{post.tags}}]+id:-{{post.id}}" limit="3" as |next|}}
{{#if next}}
<div class="otra-read-next">
    <section class="otra-pagehead">
        <h4 class="otra-pagehead-title">{{t "Related /"}}</h4>
    </section>

    <div class="otra-topic otra-topic-grid">
        <div class="otra-topic-content">
            {{#foreach next}}
            {{> "title-only" has_large_post=false}}
            {{/foreach}}
        </div>
    </div>
</div>
{{/if}}
{{/get}}
{{/is}}