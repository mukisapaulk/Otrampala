{{#is "post"}}
<aside class="otra-article-sidebar">
    <div class="otra-author-name-list">
        {{#foreach authors}}
        <h4 class="otra-author-name">
            <span>by</span>
            <a href="{{url}}">{{name}}</a>
        </h4>
        {{#unless @last}},&nbsp;{{/unless}}
        {{/foreach}}
    </div>

    <div class="otra-article-meta">
        <div class="otra-article-meta-inner">
            <div>
                <time class="otra-article-date" datetime="{{date format=" YYYY-MM-DD"}}">
                    {{date format="DD MMM YYYY, h:mm A"}}
                </time>
            </div>

            {{#if @site.comments_enabled}}
            <span class="otra-article-meta-sep"></span>
            <a class="otra-article-comments" href="#comments">
                {{comment_count}} {{t "Comments"}}
            </a>
            {{/if}}
        </div>
    </div>

    <a href="#/share" class="otra-button-share">{{t "Share"}}</a>
</aside>
{{/is}}