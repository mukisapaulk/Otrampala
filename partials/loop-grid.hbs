<article class="otra-golden-card {{post_class}}">
    <a class="otra-golden-link" href="{{url}}">

        <time class="otra-golden-time" datetime="{{date published_at format='YYYY-MM-DD'}}">
            {{date published_at timeago='true'}}
        </time>

        <div class="otra-golden-body">
            {{#if primary_tag}}
            <div class="otra-golden-tags">{{#foreach tags limit='2'}}{{#unless @first}} /
                {{/unless}}{{name}}{{/foreach}}</div>
            {{/if}}

            <h3 class="otra-golden-title">{{title}}</h3>

            {{#if custom_excerpt}}
            <p class="otra-golden-excerpt">{{custom_excerpt}}</p>
            {{else}}
            {{#if excerpt}}
            <p class="otra-golden-excerpt">{{excerpt words='30'}}</p>
            {{/if}}
            {{/if}}
        </div>

        {{#if feature_image}}
        <figure class="otra-golden-image">
            <img srcset="{{img_url feature_image size='s'}} 300w,
                        {{img_url feature_image size='m'}} 720w,
                        {{img_url feature_image size='l'}} 960w" sizes="(max-width: 700px) 100vw, 390px"
                src="{{img_url feature_image size='m'}}"
                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" loading="lazy">
        </figure>
        {{/if}}

    </a>
</article>