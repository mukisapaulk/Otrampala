<article class="otra-onlytitle-card {{post_class}}{{#match has_large_post " !=" false}}{{#has index=" 0"}}
    large{{/has}}{{/match}}">
    <a class="otra-noimg-link_wrapper" href="{{url}}">
        <div class="otra-onlytitle-card-wrapper">

            {{#if feature_image}}
            <figure class="otra-onlytitle-image">
                <img srcset="{{img_url feature_image size=" s"}} 300w, {{img_url feature_image size="m" }} 720w,
                    {{img_url feature_image size="l" }} 960w, {{img_url feature_image size="xl" }} 1200w"
                    sizes="(max-width: 600px) 100vw, 600px" src="{{img_url feature_image size=" m"}}"
                    alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
            </figure>
            {{/if}}

            {{#if primary_tag}}
            <ul class="otra-tags">
                <li class="otra-tag">{{primary_tag.name}}</li>
            </ul>
            {{/if}}

            <header class="otra-noimg-header">
                <h3 class="otra-noimg-title">{{title}}</h3>
            </header>

            {{#if primary_author}}
            <div class="otra-onlytitle-author">
                <span class="otra-card-author"> By {{primary_author.name}}</span>
            </div>
            {{/if}}

        </div>
    </a>
</article>