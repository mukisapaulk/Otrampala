{{#is "post"}}
<section class="otra-author-section">
    <div class="otra-author-card">
        {{#primary_author}}
        <a class="otra-author-avatar-link" href="{{url}}">
            {{#if profile_image}}
            <img class="otra_article-author-image" src="{{profile_image}}" alt="{{name}}">
            {{else}}
            <div class="otra-author-icon">{{> "icons/avatar"}}</div>
            {{/if}}
        </a>

        <h4 class="otra_article-author-name">
            <a href="{{url}}">{{name}}</a>
            {{#if bio}}
            <span class="otra-author-bio">is {{bio}}</span>
            {{/if}}
        </h4>
        {{/primary_author}}
    </div>
</section>
{{/is}}