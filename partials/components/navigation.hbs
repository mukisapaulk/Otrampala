<section class="ug-navigation-wrapper">
<header id="gh-navigation" class="ug-nav">
    <div class="ug-navigation-inner">
    <div class="side-a">
        <div class="ug-humburger">
        {{>"components/humburger"}}
     </div>
     
        <div class="ug-navigation-brand">
            <a class="ug-navigation-logo is-title" href="{{@site.url}}">
                {{#if @site.logo}}
                    <img src="{{@site.logo}}" alt="{{@site.title}}">
                {{else}}
                    {{@site.title}}
                {{/if}}
            </a>
           
        </div>
       </div>
       <div class="side-b">
        <nav class="ug-navigation-menu">
            {{#unless @site.members_enabled}}
                {{#match navigationLayout "Stacked"}}
                    {{> "search-toggle"}}
                {{/match}}
            {{/unless}}
        </nav>

        <div class="ug-navigation-actions">
            {{#unless @site.members_enabled}}
                {{^match navigationLayout "Stacked"}}
                    {{> "search-toggle"}}
                {{/match}}
            {{else}}
                {{> "search-toggle"}}
                <div class="ug-navigation-members">
                    {{#unless @member}}
                        {{#unless @site.members_invite_only}}
                            <a href="#/portal/signin" class="ug-button-secondary" data-portal="signin">Sign in</a>
                            {{#unless hideSubscribeButton}}
                                <a class="ug-button" href="#/portal/signup" data-portal="signup">Subscribe</a>
                            {{/unless}}
                        {{else}}
                            <a class="gh-button ug-button-secondary" href="#/portal/signin" data-portal="signin">Sign in</a>
                        {{/unless}}
                    {{else}}
                        <a class="gh-button ug-button-secondary" href="#/portal/account" data-portal="account">Account</a>
                    {{/unless}}
                </div>
            {{/unless}}
        </div>
      </div>
    </div>
</header>
<div class="ug-secondary-nav">
    <nav class="ug-menu">
                {{navigation type="secondary"}}
    </nav>
</div>
</section>