<footer class="otra-foot otra-foot-outer">
    <div class="otra-foot-inner">

        {{!-- Left: brand, tagline, subscribe --}}
        <div class="otra-foot-brand">
            <a class="otra-foot-logo" href="{{@site.url}}">
                {{@site.title}}
            </a>

            {{#if @site.description}}
            <p class="otra-foot-tagline">{{@site.description}}</p>
            {{/if}}

            {{#if @site.members_enabled}}
            {{#unless @member}}
            <section class="otra-foot-subscribe">
                <h3 class="otra-foot-subscribe-title">{{t "Subscribe to {sitetitle}" sitetitle=@site.title}}</h3>
                {{#if @custom.email_signup_text}}
                <div class="otra-foot-subscribe-text">{{@custom.email_signup_text}}</div>
                {{/if}}
                <button class="otra-foot-subscribe-btn" data-portal="signup">{{> "icons/email"}} {{t "Subscribe
                    now"}}</button>
            </section>
            {{/unless}}
            {{/if}}
        </div>

        {{!-- Middle: big link list (primary navigation) --}}
        <nav class="otra-foot-main" aria-label="Sections">
            {{navigation}}
        </nav>

        {{!-- Right: small links, social, coffee --}}
        <div class="otra-foot-side">
            <nav class="otra-foot-links" aria-label="Footer">
                {{navigation type="secondary"}}
            </nav>

            <div class="otra-foot-social">
                {{#social_accounts @site}}
                <a href="{{href}}" target="_blank" rel="noopener" aria-label="{{name}}">
                    {{#> (concat "icons/" type)}}
                    {{!-- Fallback when no per-platform icon partial exists --}}
                    <span>{{name}}</span>
                    {{/undefined}}
                </a>
                {{/social_accounts}}
            </div>

            <a class="otra-foot-coffee" href="https://buymeacoffee.com/mukisapauls" target="_blank"
                rel="noopener">
                <img src="https://cdn.buymeacoffee.com/buttons/bmc-new-btn-logo.svg" alt="" width="20" height="28">
                <span>Buy me a coffee</span>
            </a>
        </div>

        {{!-- Bottom bar --}}
        <div class="otra-foot-bottom">
            <div class="otra-foot-copyright">
                {{#unless @custom.footer_text}}
                {{@site.title}} © {{date format="YYYY"}}
                {{else}}
                {{@custom.footer_text}}
                {{/unless}}
            </div>
            <div class="otra-foot-credit">
                {{{t "Powered by {ghostlink}" ghostlink="<a href=\"https://ghost.org/\" target=\"_blank\"
                    rel=\"noopener\">Ghost</a>"}}}
            </div>
        </div>

    </div>
</footer>